<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--PublishAot>true</PublishAot-->
	<IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
	  <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	  <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JasperFx" Version="2.102.0" />
    <PackageReference Include="JasperFx.Events" Version="2.102.0" />
    <PackageReference Include="JasperFx.Events.SourceGenerator" Version="2.102.0" />
    <PackageReference Include="JasperFx.SourceGenerator" Version="2.102.0" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
    <PackageReference Include="Weasel.Core" Version="9.50.0" />
    <PackageReference Include="Weasel.MySql" Version="9.50.0" />
    <PackageReference Include="Weasel.Postgresql" Version="9.50.0" />
    <PackageReference Include="Weasel.Sqlite" Version="9.50.0" />
    <PackageReference Include="WolverineFx" Version="6.63.0" />
    <PackageReference Include="WolverineFx.MySql" Version="6.63.0" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.63.0" />
    <PackageReference Include="WolverineFx.Sqlite" Version="6.63.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
	<PackageReference Include="JasperFx.RuntimeCompiler" Version="5.1.0" />
	<PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.63.0" />
  </ItemGroup>
	
  <ItemGroup>
	<None Update="Resources/Config/Shortly.Development.toml" Condition="'$(Configuration)' == 'Debug'">
	  <Link>%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<None Update="Resources/Config/Shortly.toml">
	  <Link>%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>
  
  <ItemGroup>
    <Content Remove="Resources/Config/Default.Debug.json" /> 
	<EmbeddedResource Include="Resources/Config/Default.Debug.json" Condition="'$(Configuration)' == 'Debug'" Link="Resources\Config\Default.json" />
	<Content Remove="Resources/Config/Default.Release.json" /> 
	<EmbeddedResource Include="Resources/Config/Default.Release.json" Condition="'$(Configuration)' == 'Release'" Link="Resources\Config\Default.json" />
  </ItemGroup>

</Project>
