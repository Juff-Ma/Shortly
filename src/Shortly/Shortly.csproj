<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup>
	  <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	  <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
  </ItemGroup>
	
  <ItemGroup>
	<None Update="Resources/Config/Shortly.Development.toml" Condition="'$(Configuration)' == 'Debug'">
	  <Link>%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<None Update="Resources/Config/Shortly.toml">
	  <Link>%(Filename)%(Extension)</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	<EmbeddedResource Include="Resources/Config/Default.Debug.json" Condition="'$(Configuration)' == 'Debug'" Link="Resources\Config\Default.json" />
	<EmbeddedResource Include="Resources/Config/Default.Release.json" Condition="'$(Configuration)' == 'Release'" Link="Resources\Config\Default.json" />
  </ItemGroup>

</Project>
